{
  "Rules": [
    {
      "ID": "safevault-full-backup-retention",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "full/"
      },
      "Expiration": {
        "Days": 90
      }
    },
    {
      "ID": "safevault-base-backup-retention",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "base/"
      },
      "Expiration": {
        "Days": 60
      }
    },
    {
      "ID": "safevault-wal-retention",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "wal/"
      },
      "Expiration": {
        "Days": 60
      }
    }
  ]
}

